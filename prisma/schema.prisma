generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WaterStatus {
  safe
  warning
  danger
}

enum ReviewStatus {
  pending
  approved
  edited_approved // เพิ่มสถานะ Admin แก้ไขแล้วอนุมัติ
  rejected
}

model Role {
  id           Int           @id @default(autoincrement())
  roleName     String        @unique @map("role_name")
  
  users        User[]
  roleRequests RoleRequest[]

  @@map("roles")
}

model User {
  id               Int             @id @default(autoincrement())
  lineUniqueId     String          @unique @map("line_unique_id")
  lineProfileName  String          @map("line_profile_name")
  firstName        String?         @map("first_name")
  lastName         String?         @map("last_name")
  phoneNumber      String?         @map("phone_number")
  
  roleId           Int             @map("role_id")
  systemRole       Role            @relation(fields: [roleId], references: [id])
  
  samples          WaterSample[]
  roleRequests     RoleRequest[]
  reviewedRequests ReviewRequest[] @relation("ReviewedByUser")
  notifications    Notification[]  @relation("UserNotifications") // เชื่อมโยงกับแจ้งเตือนของ User

  registeredAt     DateTime        @default(now()) @map("registered_at")
  lastActiveAt     DateTime        @updatedAt @map("last_active_at")

  @@map("users")
}

model RoleRequest {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  requestedRoleId Int      @map("requested_role_id")
  requestedRole   Role     @relation(fields: [requestedRoleId], references: [id])
  
  status          String   @default("pending") @map("status")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("role_requests")
}

model LocationType {
  id        Int        @id @default(autoincrement())
  code      String     @unique @map("code")
  labelTh   String     @map("label_th")

  standards Standard[]

  @@map("location_types")
}

model Standard {
  id             Int          @id @default(autoincrement())

  locationTypeId Int          @map("location_type_id")
  locationType   LocationType @relation(fields: [locationTypeId], references: [id], onDelete: Cascade)

  parameterId    Int          @map("parameter_id")
  parameter      Parameter    @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  maxValue       Float        @map("max_value")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([locationTypeId, parameterId])
  @@map("standards")
}

model Location {
  id              Int           @id @default(autoincrement())
  stationName     String        @map("station_name")
  governingAgency String        @map("governing_agency")
  latitude        Float         @map("latitude")
  longitude       Float         @map("longitude")

  samples         WaterSample[]
  weatherData     WeatherData[]

  createdActiveAt DateTime      @default(now()) @map("created_active_at")
  updatedActiveAt DateTime      @updatedAt @map("updated_active_at")

  @@map("locations")
}

// -------------------------------------------------------------
// 1. STAGING / WORKFLOW TABLES
// -------------------------------------------------------------

model WaterSample {
  id               Int                      @id @default(autoincrement())
  code             String?                  @map("code")
  
  collectorId      Int                      @map("collector_id")
  collector        User                     @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  
  locationId       Int                      @map("location_id")
  location         Location                 @relation(fields: [locationId], references: [id], onDelete: Cascade)
  
  collectionTime   DateTime                 @map("collection_time")
  uploadedActiveAt DateTime                 @default(now()) @map("uploaded_active_at")
  
  dissolvedOxygen  Float?                   @map("dissolved_oxygen")
  airTemperature   Float?                   @map("air_temperature")
  rainAccumulation Float?                   @map("rain_accumulation")
  weatherCondCode  Int?                     @map("weather_cond_code")
  
  status           WaterStatus
  sessionGroup     String?                  @map("session_group")
  
  rawImageUrl      String?                  @map("raw_image_url") @db.Text
  imageExpiresAt   DateTime?                @map("image_expires_at")
  isDeleted        Boolean                  @default(false) @map("is_deleted")
  analyzedPlotUrl  String?                  @map("analyzed_plot_url") @db.Text
  
  lastModifiedBy   Int?                     @map("last_modified_by")
  updatedActiveAt  DateTime                 @default(now()) @updatedAt @map("updated_active_at")

  measurements     WaterSampleMeasurement[]

  @@index([sessionGroup])
  @@index([code])
  @@index([collectionTime])
  @@index([locationId, collectionTime])
  @@index([status, collectionTime])
  @@map("samples")
}

model Parameter {
  id          Int                      @id @default(autoincrement())
  name        String                   @unique @map("name")
  unit        String?                  @map("unit")
  description String?                  @db.Text
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  measurements WaterSampleMeasurement[]
  widgets      DashboardWidget[]
  standards    Standard[]

  @@map("parameters")
}

model WaterSampleMeasurement {
  id          Int         @id @default(autoincrement())
  sampleId    Int         @map("sample_id")
  parameterId Int         @map("parameter_id")
  value       Float       @map("value")      
  confidence  Float       @map("confidence")  
  boundingBox Json?       @map("bounding_box") 
  message     String?     @db.Text

  sample      WaterSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  parameter   Parameter   @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@unique([sampleId, parameterId])
  @@map("sample_measurements")
}

model ReviewRequest {
  id             Int          @id @default(autoincrement())
  sessionGroup   String       @unique @map("session_group")
  statusRequest  ReviewStatus @default(pending) @map("status_request")

  reviewedById   Int?         @map("reviewed_by_id")
  reviewedBy     User?        @relation("ReviewedByUser", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt     DateTime?    @map("reviewed_at")
  reviewNote     String?      @map("review_note") @db.Text
  acknowledgedAt DateTime?    @map("acknowledged_at")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([statusRequest])
  @@map("review_requests")
}

// -------------------------------------------------------------
// 2. MASTER DATA (IMMUTABLE & INDEPENDENT)
// -------------------------------------------------------------

model SampleRecord {
  id                       Int         @id @default(autoincrement())
  code                     String?     @map("code")
  
  // Snapshot ข้อมูลผู้เก็บ
  collectorNameFrom        String?     @map("collector_name_from")
  collectorNameCurrentId   Int?        @map("collector_name_current_id")
  
  // Snapshot ข้อมูลสถานที่
  // ชื่อสถานี/หน่วยงาน เก็บค่า ณ วันที่บันทึก ส่วน CurrentId ชี้กลับไปยังสถานีจริงที่อาจถูกแก้ไขภายหลัง
  locationNameFrom         String?     @map("location_name_from")
  governingAgencyFrom      String?     @map("governing_agency_from")
  locationNameCurrentId    Int?        @map("location_name_current_id")
  
  collectionTime           DateTime    @map("collection_time")
  uploadedActiveAt         DateTime    @default(now()) @map("uploaded_active_at")
  
  dissolvedOxygen          Float?      @map("dissolved_oxygen")
  airTemperature           Float?      @map("air_temperature")
  rainAccumulation         Float?      @map("rain_accumulation")
  weatherCondCode          Int?        @map("weather_cond_code")
  status                   WaterStatus @map("status")
  
  imageUrl                 Json?       @map("image_url") // รวม { rawImageUrl, plotImageUrl }
  imageExpiresAt           DateTime?   @map("image_expires_at")
  isDeleted                Boolean     @default(false) @map("is_deleted")
  
  lastModifiedBy           Int?        @map("last_modified_by")
  updatedActiveAt          DateTime    @default(now()) @updatedAt @map("updated_active_at")
  
  // Self-contained Array of Object สำหรับผลตรวจสารทั้งหมด
  parameterData            Json        @map("parameter_data")
  reviewedById             Int?        @map("reviewed_by_id")

  @@index([code])
  @@index([collectionTime])
  @@index([locationNameCurrentId, collectionTime])
  @@map("sample_record")
}

// -------------------------------------------------------------
// 3. NOTIFICATION & AUDIT LOGS
// -------------------------------------------------------------

model Notification {
  id        Int          @id @default(autoincrement())
  userId    Int?         @map("user_id") // ส่งให้ User คนไหน
  code      String?      @map("code")    // Sample Code อ้างอิง
  status    ReviewStatus @map("status")  // ผลการตรวจสอบ (approved / edited_approved / rejected)
  message   String?      @db.Text        // เหตุผล / ข้อความแจ้งเตือน
  reviewBy  Int?         @map("review_by") // ผู้ตรวจสอบ
  isReading Boolean      @default(false) @map("is_reading") // สถานะการเปิดอ่าน
  createdAt DateTime     @default(now()) @map("created_at")

  user      User?        @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isReading])
  @@map("noti")
}

model SampleRawLog {
  id                  Int      @id @default(autoincrement())
  sessionGroup        String?  @map("session_group")
  sampleParameterName Json     @map("sample_parameter_name") // ค่าสารเดิมก่อนถูกแก้ หรือ ค่าสารที่พัง
  message             Json?    @map("message")               // เหตุผลปฏิเสธแต่ละสาร
  imageRawUrl         Json?    @map("image_raw_url")         // URLs รูปดิบ/Bounding box
  reviewedById        Int?     @map("reviewed_by_id")        // ผู้ตรวจ
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([sessionGroup])
  @@map("sample_raw_log")
}

// -------------------------------------------------------------
// 4. DASHBOARD & SYSTEM
// -------------------------------------------------------------

model DashboardWidget {
  id           Int        @id @default(autoincrement())
  title        String     @map("title")
  widgetType   String     @map("widget_type")
  metricType   String     @map("metric_type")
  targetType   String     @map("target_type")
  targetColumn String?    @map("target_column")
  parameterId  Int?       @map("parameter_id")
  filterValue  String?    @map("filter_value")
  unit         String?    @map("unit")
  cardColor    String     @default("blue") @map("card_color")
  width        Int        @default(3) // ความกว้างกริดของการ์ด นับเป็นช่องจาก 12 ช่อง
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  parameter    Parameter? @relation(fields: [parameterId], references: [id], onDelete: SetNull)

  @@map("dashboard_widgets")
}

model WeatherData {
  id               String   @id @default(uuid())
  locationId       Int      @map("location_id")
  timestamp        DateTime
  temperature      Float
  rainVolume       Float
  weatherCondition Int
  createdAt        DateTime @default(now()) @map("created_at")

  location         Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, timestamp])
  @@index([locationId])
  @@index([timestamp])
  @@map("weather_data")
}