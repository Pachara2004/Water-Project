generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WaterStatus {
  safe
  warning
  danger
}

// สถานะการตรวจสอบผลตรวจที่ confidence ต่ำกว่าเกณฑ์ (คนละมิติกับ WaterStatus)
enum ReviewStatus {
  pending
  approved
  rejected
}

model Role {
  id           Int           @id @default(autoincrement())
  roleName     String        @unique @map("role_name")
  
  users        User[]
  roleRequests RoleRequest[]

  @@map("roles")
}

model User {
  id              Int           @id @default(autoincrement())
  lineUniqueId    String        @unique @map("line_unique_id")
  lineProfileName String        @map("line_profile_name")
  firstName       String?       @map("first_name")
  lastName        String?       @map("last_name")
  phoneNumber     String?       @map("phone_number")
  
  roleId          Int           @map("role_id")
  systemRole      Role          @relation(fields: [roleId], references: [id])
  
  samples         WaterSample[]
  roleRequests    RoleRequest[]
  
  registeredAt    DateTime      @default(now()) @map("registered_at")
  lastActiveAt    DateTime      @updatedAt @map("last_active_at")

  @@map("users")
}

model RoleRequest {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  requestedRoleId Int      @map("requested_role_id")
  requestedRole   Role     @relation(fields: [requestedRoleId], references: [id])
  
  status          String   @default("pending") @map("status")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("role_requests")
}

model Location {
  id              Int           @id @default(autoincrement())
  stationName     String        @map("station_name")
  governingAgency String        @map("governing_agency")
  latitude        Float         @map("latitude")
  longitude       Float         @map("longitude")
  
  samples         WaterSample[]
  
  createdActiveAt DateTime      @default(now()) @map("created_active_at")
  updatedActiveAt DateTime      @updatedAt @map("updated_active_at")

  @@map("locations")
}

model WaterSample {
  id               Int                      @id @default(autoincrement())
  
  collectorId      Int                      @map("collector_id")
  collector        User                     @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  
  locationId       Int                      @map("location_id")
  location         Location                 @relation(fields: [locationId], references: [id], onDelete: Cascade)
  
  collectionTime   DateTime                 @map("collection_time")
  uploadedActiveAt DateTime                 @default(now()) @map("uploaded_active_at")
  
  dissolvedOxygen  Float?                   @map("dissolved_oxygen")
  airTemperature   Float?                   @map("air_temperature")
  rainAccumulation Float?                   @map("rain_accumulation")
  weatherCondCode  Int?                     @map("weather_cond_code")
  
  status           WaterStatus
  
  sessionGroup     String?                  @map("session_group")
  
  rawImageUrl      String?                  @map("raw_image_url") @db.Text
  imageExpiresAt   DateTime?                @map("image_expires_at")
  isDeleted        Boolean                  @default(false) @map("is_deleted")
  analyzedPlotUrl  String?                  @map("analyzed_plot_url") @db.Text
  
  lastModifiedBy   Int?                     @map("last_modified_by")
  updatedActiveAt  DateTime                 @default(now()) @updatedAt @map("updated_active_at")

  measurements     WaterSampleMeasurement[]

  // เชื่อมกับ ReviewRequest ผ่าน sessionGroup (string link ไม่ใช่ FK จริง — ดู ReviewRequest ด้านล่าง)
  @@index([sessionGroup])
  @@map("samples")
}

// 1. ตารางสำหรับเก็บรายชื่อสาร/พารามิเตอร์ทั้งหมดในระบบ (Master Data)
model Parameter {
  id          Int                      @id @default(autoincrement())
  name        String                   @unique @map("name") // เช่น "ammonia", "phosphate", "nitrate", "ph"
  unit        String?                  @map("unit") // เช่น "mg/L", "pH"
  description String?                  @map("description") @db.Text
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  // Relation กลับไปยังตารางบันทึกผล
  measurements WaterSampleMeasurement[]
  widgets      DashboardWidget[]
  @@map("parameters")
}

// 2. ตารางเชื่อม (Junction Table) สำหรับเก็บค่าผลลัพธ์ของสารแต่ละชนิดในรอบการเก็บน้ำนั้นๆ
model WaterSampleMeasurement {
  id          Int         @id @default(autoincrement())
  sampleId    Int         @map("sample_id")
  parameterId Int         @map("parameter_id")
  value       Float       @map("value")      
  confidence  Float       @map("confidence")  
  boundingBox String?     @map("bounding_box") 
  message     String?     @map("message") @db.Text

  sample      WaterSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  parameter   Parameter   @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  // ทำ Unique Constraint ร่วมกัน เพื่อป้องกันไม่ให้สารชนิดเดียวกัน บันทึกซ้ำซ้อนใน Sample ID เดียวกัน
  @@unique([sampleId, parameterId])
  @@map("sample_measurements")
}

// คำร้องขอตรวจสอบผลตรวจที่ confidence ต่ำกว่าเกณฑ์ — 1 คำร้องต่อ 1 sessionGroup (1:1 กับการเก็บ 1 ครั้ง)
// จงใจไม่ประกาศ @relation ไปยัง WaterSample.sessionGroup เพราะฝั่งนั้นไม่ unique (ตั้งใจให้หลายแถวใช้ sessionGroup ร่วมกัน)
// การอ่านข้อมูลข้ามสองตารางนี้ต้อง query แยกด้วย sessionGroup เอง ดู lib/review.ts
model ReviewRequest {
  id            Int          @id @default(autoincrement())
  sessionGroup  String       @unique @map("session_group")

  statusRequest ReviewStatus @default(pending) @map("status_request")

  reviewedById  Int?         @map("reviewed_by_id")
  reviewedAt    DateTime?    @map("reviewed_at")
  reviewNote    String?      @map("review_note") @db.Text

  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([statusRequest])
  @@map("review_requests")
}

model DashboardWidget {
  id           Int      @id @default(autoincrement())
  title        String   @map("title")         // ชื่อหัวข้อที่จะแสดงบนการ์ดหรือกราฟ
  widgetType   String   @map("widget_type")   // ประเภท: 'CARD', 'LINE_CHART', 'PIE_CHART', 'BAR_CHART'
  
  metricType   String   @map("metric_type")   // ประเภทสถิติ: 'COUNT', 'AVG', 'SUM', 'MIN', 'MAX'
  targetType   String   @map("target_type")   // เป้าหมาย: 'SAMPLE_STATUS' (สถานะรวม), 'ENVIRONMENT' (ค่าส่วนกลาง), 'PARAMETER' (สารเคมีย่อย)
  targetColumn String?  @map("target_column") // ใช้กรณี ENVIRONMENT: 'dissolved_oxygen', 'air_temperature', 'rain_accumulation'
  parameterId  Int?     @map("parameter_id")  // ใช้กรณี PARAMETER: เชื่อมผูกกับ ID ของตาราง Parameter
  filterValue  String?  @map("filter_value")  // เงื่อนไขตัวกรองค่า เช่น 'safe', 'warning', 'danger'
  unit         String?  @map("unit")           // หน่วยนับ เช่น 'รายการ', 'mg/L', '%'
  cardColor    String   @default("blue") @map("card_color") // สีธีมหลัก: 'blue', 'red', 'green', 'yellow'

  w            Int      @default(3)           // ความกว้างกริดบนหน้าจอ เช่น 3, 4, 6, 12 ช่อง

  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relation เชื่อมต่อไปตาราง Parameter
  parameter    Parameter? @relation(fields: [parameterId], references: [id], onDelete: SetNull)

  @@map("dashboard_widgets")
}